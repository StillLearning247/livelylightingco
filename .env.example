# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# vCita API (Supabase edge function secrets)
VCITA_URL=https://api.vcita.biz/platform/v1

# Trelli CRM lead intake (Supabase edge function secrets, set in dashboard)
# TRELLI_API_KEY is required to enable the Trelli dual-write; if unset the push
# is skipped. TRELLI_API_URL defaults to the production endpoint when omitted.
TRELLI_API_KEY=your_trelli_api_key_with_leads_write_scope
TRELLI_API_URL=https://trellicrm.com/api/v1/leads

# Google Sheets Integration
VITE_GOOGLE_SHEET_ID=your_sheet_id
VITE_GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account_email
VITE_GOOGLE_PRIVATE_KEY=your_private_key

# Google Maps Platform — address autocomplete on the consultation form.
# Create a browser API key with "Places API (New)" and "Maps JavaScript API"
# enabled, then restrict it by HTTP referrer to your domain(s).
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_browser_api_key

# Cloudinary (for gallery uploads)
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# Admin credentials for Playwright testing (optional)
ADMIN_EMAIL=your_admin_email
ADMIN_PASSWORD=your_admin_password
